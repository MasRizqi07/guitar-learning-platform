# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/guitar_learning_db?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/guitar_learning_db?schema=public"

# Auth Secret (generate with `openssl rand -base64 32`)
AUTH_SECRET="your-32-char-random-auth-secret-here"
AUTH_URL="http://localhost:3000"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Release & Operations Telemetry (Phase G)
GIT_SHA=""
# Cryptographically strong server-only secret for internal ops/readiness probes (never share with AUTH_SECRET; never expose via NEXT_PUBLIC)
INTERNAL_OPS_TOKEN="your-cryptographically-strong-internal-ops-token"

# Rate Limiting (Upstash Redis REST - required for multi-instance production; in-memory fallback permitted in development/test only)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Transactional Email (Resend - optional, falls back to ConsoleEmailProvider)
RESEND_API_KEY=""

# Error Monitoring (Sentry - optional, falls back to ConsoleErrorProvider)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Product Analytics (PostHog - optional, falls back to console logger)
POSTHOG_API_KEY=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Object Storage Provider (Phase D)
# Options: mock (default for local/CI), s3, r2
STORAGE_PROVIDER="mock"
STORAGE_BUCKET="guitar-learning-media"
STORAGE_REGION="auto"
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID="your_storage_access_key_id"
STORAGE_SECRET_ACCESS_KEY="your_storage_secret_access_key"
STORAGE_PUBLIC_BASE_URL="https://media.guitarlearning.com"
